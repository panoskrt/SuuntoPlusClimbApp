    { "name": "ascent", "source": "Fusion/Altitude/Ascent", "type": "subscribe" }
  ],
  "out": [
    { "name": "gradient", "log": true },
    { "name": "vam", "log": true },
    { "name": "category" },
    { "name": "categoryGroup" },
    { "name": "maxgradient", "log": true },
    { "name": "totalAscent" },
    { "name": "avgGradient", "log": true }
  ],
  "template": [{ "name": "t.html" }, { "name": "t2.html" }],
  "image": []
}
